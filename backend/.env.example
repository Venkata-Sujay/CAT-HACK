# Copy to backend/.env and adjust. Every value below is optional -- the defaults
# in app/config.py are tuned for the demo.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is the default because this machine has no PostgreSQL and no running
# Docker daemon. The schema is portable -- switching engines needs no code change.
# DATABASE_URL=sqlite:///./rental.db
# DATABASE_URL=postgresql+psycopg://rental:rental@localhost:5432/rental
# SQL_ECHO=false

# ---------------------------------------------------------------------------
# Auth -- CHANGE SECRET_KEY FOR ANY REAL DEPLOYMENT
# ---------------------------------------------------------------------------
# SECRET_KEY=dev-only-insecure-key-change-me-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Simulator
# ---------------------------------------------------------------------------
# DEMO_TICK_SECONDS=10             # real seconds between ticks
# SIMULATED_MINUTES_PER_TICK=15    # simulated asset-time per tick
# SIMULATION_SEED=42               # deterministic -> reproducible demo
# SIMULATOR_AUTOSTART=true

# Anomaly rates are per RUNNING asset per tick, calibrated so a 20-30 minute demo
# produces a handful of new events. Raising them re-creates the fleet-wide
# "epidemic" problem documented in PROJECT_STATE.md.
# SIM_TIRE_DEGRADE_PROB=0.0015
# SIM_ENGINE_DEGRADE_PROB=0.0010
# SIM_OPERATOR_MISMATCH_PROB=0.005

# Assets the simulator keeps parked (comma-separated). EQX1007 is the scripted
# demo anomaly and must stay idle for Demo Scene 2 to survive a long presentation.
# SIM_PARKED_ASSET_CODES=EQX1007

# ---------------------------------------------------------------------------
# Rule engine thresholds
# These are configurable OPERATIONAL RECOMMENDATIONS, not certified machinery
# safety limits, and the UI labels them as such.
# ---------------------------------------------------------------------------
# CONTINUOUS_USAGE_THRESHOLD_MINUTES=360
# LOW_FUEL_THRESHOLD=20.0
# DUE_SOON_HOURS=48
# CLIENT_HIGH_UTILIZATION_THRESHOLD=0.85
